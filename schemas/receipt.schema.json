{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vannt-dev/ai-engineering-skills/main/schemas/receipt.schema.json",
  "title": "AI Engineering Skills installation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collection", "version", "target", "scope", "installedAt", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collection": { "const": "ai-engineering-skills" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
    "target": { "enum": ["Codex", "Claude", "OpenCode", "Antigravity", "Universal"] },
    "scope": { "enum": ["User", "Project"] },
    "installedAt": { "type": "string", "format": "date-time" },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
